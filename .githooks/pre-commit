#!/bin/sh
# Blocks a commit that contains an API key, a Wi-Fi password, sdkconfig or
# another private file. Turn it on once per clone, from the repository folder:
#
#     git config core.hooksPath .githooks
#
# Git for Windows runs this with its own sh, so it works from PowerShell, CMD
# and the ESP-IDF terminals as well as macOS and Linux shells.

root="$(git rev-parse --show-toplevel)" || exit 2
for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
        exec "$py" "$root/scripts/check_secrets.py" --staged
    fi
done
echo "pre-commit: no Python 3.8+ found, so the secret check could not run." >&2
echo "Install Python (https://www.python.org/downloads/) or commit from an ESP-IDF terminal." >&2
exit 1
